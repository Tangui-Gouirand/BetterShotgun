{
  "manifest_version": 3,
  "name": "Shotgun - Révélateur de lieu",
  "version": "1.1.0",
  "description": "Affiche les coordonnées et l'adresse publiées dans les données de la page d'un événement Shotgun, et signale les lieux non divulgués.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://shotgun.live/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Révéler le lieu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
