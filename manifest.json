{
  "manifest_version": 3,
  "name": "Shotgun - Révélateur de lieu",
  "version": "1.2.0",
  "description": "Affiche l'adresse publiée d'un événement Shotgun, signale les lieux non divulgués, et ajoute une vue rapide filtrable de l'agenda d'une ville.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://shotgun.live/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lieu de l'événement · vue rapide de l'agenda",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
